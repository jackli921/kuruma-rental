{
  "name": "@kuruma/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --port 3001",
    "build": "vite build",
    "preview": "vite preview --port 3001",
    "pages:create-project": "wrangler pages project create kuruma-web-pages --production-branch=production --compatibility-date=2025-04-01 --compatibility-flag=nodejs_compat --compatibility-flag=global_fetch_strictly_public",
    "deploy:pages": "wrangler pages deploy dist --project-name=kuruma-web-pages --branch=production --commit-dirty=true",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@kuruma/shared": "workspace:*",
    "@sentry/react": "^10",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-router": "^1.170.15",
    "@types/react-big-calendar": "^1.16.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.7.0",
    "pigeon-maps": "^0.22.1",
    "react": "19.2.4",
    "react-big-calendar": "^1.19.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "use-intl": "^4.13.0"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^5.3.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/router-plugin": "^1.168.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "happy-dom": "^20.8.9",
    "tailwindcss": "^4",
    "vite": "^6",
    "vitest": "^2",
    "wrangler": "^4.80.0"
  }
