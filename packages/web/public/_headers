# Cloudflare Pages response headers (spec §6.1). Rules are path-prefix matched.

# Content-hashed bundles are immutable — Vite fingerprints every file under
# /assets, so a new deploy always ships new URLs. Cache them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The app shell and locale data are re-fetched each deploy; never cache them so a
# new release takes effect immediately (the shell pulls the fresh asset URLs).
/index.html
  Cache-Control: no-cache
/messages/*
  Cache-Control: no-cache

# Baseline hardening on every Pages response. Enforced headers below are all safe
# for this app (redirect-based OAuth, same-origin /api proxy, no framing).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  # CSP is ENFORCED (#500): the browser blocks violations, not just reports them.
  # The inline locale bootstrap in index.html is pinned by its sha256 hash instead
  # of 'unsafe-inline'; CI guards recompute it (tests/deploy/csp-script-hash.test.ts
  # at source, scripts/lint-csp-hash.ts against dist) so it can't silently drift
  # and block the script. style-src keeps 'unsafe-inline' — inline style attributes
  # can't be hashed. COEP is omitted — `require-corp` would block Unsplash images.
  # img-src also allows *.googleusercontent.com for the signed-in user's Google
  # avatar (UserMenu). Verified locally against the app shell, OAuth redirect init,
  # Unsplash imagery, and the signed-in avatar (zero violations); final sign-off on
  # a live CF preview tracks in #1009.
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https://images.unsplash.com https://*.googleusercontent.com; style-src 'self' 'unsafe-inline'; script-src 'self' 'sha256-2S6frsINm4/FKaaiq6qA65fjvkeL2N9Um5j1Yra+lT0='; font-src 'self' data:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
