{
  "name": "@kuruma/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy --outdir dist --var SENTRY_RELEASE:$(git rev-parse HEAD)",
    "sentry:sourcemaps": "sentry-cli sourcemaps upload --org \"$SENTRY_ORG\" --project \"$SENTRY_PROJECT_API\" --release \"$SENTRY_RELEASE\" dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:neon": "vitest run --config vitest.neon.config.ts",
    "typecheck": "tsc --noEmit",
    "lint:boundaries": "bun run scripts/check-import-boundaries.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.1",
    "@elithrar/workers-hono-rate-limit": "^0.5.1",
    "@kuruma/shared": "workspace:*",
    "@sentry/cloudflare": "^10.57.0",
    "hono": "^4",
    "jose": "^6.0.6",
    "nanoid": "^5.1.11",
    "stripe": "^22.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260410.1",
    "@neondatabase/serverless": "^1.0.2",
    "@sentry/cli": "2.58.6",
    "@types/ws": "^8.5.12",
    "postgres": "^3.4.8",
    "vitest": "^2",
    "wrangler": "^4.80.0",
    "ws": "^8.18.0"
  }
}
