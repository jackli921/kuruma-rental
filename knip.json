{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.ts",
        "e2e/mock-api.ts",
        "e2e/real-db/auth.setup.ts",
        "e2e/real-db/real-api-server.ts"
      ],
      "ignore": ["scripts/__fixtures__/**"],
      "ignoreDependencies": ["postgres", "drizzle-orm", "@auth/core", "jose", "@kuruma/shared"]
    },
    "packages/api": {
      "ignore": ["tests/**"],
      "ignoreDependencies": ["jose", "drizzle-orm", "zod", "ws", "@types/ws"]
    },
    "packages/web": {
      "entry": ["src/routes/**/*.{ts,tsx}", "functions/**/*.ts"],
      "ignore": ["src/components/ui/**", "src/vite/vite-env.d.ts", "postcss.config.mjs"],
      "ignoreDependencies": ["postcss", "@tailwindcss/postcss", "@kuruma/api", "drizzle-orm", "zod"]
    },
    "packages/shared": {}
  },
  "ignore": ["packages/shared/postcss.config.mjs"],
  "ignoreExportsUsedInFile": true
}
